# ============================================================================
# TradeInsight AI — Frontend · LOCAL DEV template
# ----------------------------------------------------------------------------
# Copy this file to `.env.local` and fill in the values. `.env.local` is
# gitignored so your real values never end up in git.
#
#   cp .env.local.example .env.local
#
# For PRODUCTION (Vercel), do NOT use a file. Set env vars in
# Project Settings → Environment Variables. See .env.production.example for
# the exact list.
# ============================================================================

# Backend API base URL.
#   Local dev (backend on host):         http://localhost:8000
#   Local dev (backend in docker-compose): http://backend:8000
#   Production (Render):                 https://tradeinsight-api.onrender.com
NEXT_PUBLIC_API_URL=http://localhost:8000

# Optional: Google Analytics measurement ID. Leave empty to disable.
NEXT_PUBLIC_GA_ID=
