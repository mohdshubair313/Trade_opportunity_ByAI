# ============================================================================
# TradeInsight AI — Frontend · PRODUCTION (Vercel) template
# ----------------------------------------------------------------------------
# This file is documentation only. Do NOT create a `.env.production` file in
# this repo — Vercel won't read it. Instead, set each variable below in:
#
#   Vercel Dashboard → Project → Settings → Environment Variables
#
# Apply to: Production (and Preview if you want previews to work against
# the live backend). After adding/changing any NEXT_PUBLIC_* variable you
# MUST redeploy — Next.js inlines these into the build output, so the value
# sitting in Vercel's env-var panel doesn't reach the browser until a new
# build runs:
#
#   Deployments → latest → ⋮ → Redeploy
# ============================================================================

# Backend API base URL — the URL of your deployed FastAPI backend on Render.
# Must be HTTPS in production. No trailing slash.
# (The frontend strips a trailing slash defensively, but clean URLs are nicer.)
NEXT_PUBLIC_API_URL=https://tradeinsight-api.onrender.com

# NOTE: the frontend itself has nothing to configure for CORS — CORS is a
# backend concern. Make sure the BACKEND's `CORS_ORIGINS` env var on Render
# lists this frontend's public origin, e.g.:
#   CORS_ORIGINS=https://tradeinsight.shubair.in,https://tradeinsight-frontend.vercel.app

# Optional: Google Analytics 4 measurement ID (format: G-XXXXXXXXXX).
# Leave empty to disable analytics in production.
NEXT_PUBLIC_GA_ID=
