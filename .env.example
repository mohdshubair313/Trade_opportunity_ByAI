# ==============================================================================
# TradeInsight AI — Environment Variables Template
# Copy this file to `.env` and supply your actual secrets.
# NEVER commit your actual `.env` file to version control.
# ==============================================================================

# Application Environment (development, staging, production)
ENVIRONMENT=development
DEBUG=false
APP_NAME=Trade Opportunities API
VERSION=2.0.0
PUBLIC_APP_URL=http://localhost:3000

# Security (JWT secret: ≥32 random characters in production)
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=replace_with_a_secure_random_hex_string_at_least_32_chars_long
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Database Connection (PostgreSQL or SQLite for local dev)
DATABASE_URL=sqlite:///./trade_opportunities_v2.db

# Rate Limiting (Optional Redis URL for multi-worker deployments)
RATE_LIMIT_PER_MINUTE=10
# REDIS_URL=redis://localhost:6379/0

# CORS Configuration (comma-separated origins)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# CORS_ORIGIN_REGEX=https://.*\.vercel\.app

# LLM & AI Providers
GEMINI_API_KEY=your_gemini_api_key_here
OPENROUTER_API_KEY=your_openrouter_api_key_here
DEEPGRAM_API_KEY=your_deepgram_api_key_here

# Email Verification (Resend)
RESEND_API_KEY=re_your_resend_api_key_here
ALERT_FROM_EMAIL=TradeInsight <otp@yourdomain.com>

# Payments (Razorpay)
RAZORPAY_KEY_ID=rzp_test_your_key_id_here
RAZORPAY_KEY_SECRET=your_razorpay_key_secret_here
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret_here

# Cloud Storage (Supabase Storage)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=your_supabase_service_role_key_here
SUPABASE_REPORTS_BUCKET=reports
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here
