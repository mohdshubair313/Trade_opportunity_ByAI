# ============================================================================
# TradeInsight AI — Backend env template
# ----------------------------------------------------------------------------
# Copy to `.env` at the repo root and fill in your own values:
#   cp app/.env.example .env
# `.env` is gitignored. Never commit real keys.
# ============================================================================

# --- AI providers (at least one recommended) ---------------------------------
# OpenRouter: multi-model router (Gemma 4, Qwen, Llama, Nemotron on free tier).
# Get a key at https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Google Gemini: used for grounded research via google_search tool.
# Get a key at https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# Deepgram: used for Indian-accented TTS (Thalia, Zeus, Arcas) and the
# WebSocket-based voice agent pipeline (Nova-3 STT + Aura-2 TTS).
# Get a key at https://console.deepgram.com/
DEEPGRAM_API_KEY=

# Razorpay: payment order creation + signature verification + webhooks.
# Get test/live keys from https://dashboard.razorpay.com/
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Webhook secret configured on the Razorpay dashboard for this endpoint.
RAZORPAY_WEBHOOK_SECRET=

# --- Security ---------------------------------------------------------------
# JWT signing key. Minimum 32 characters. Generate with:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-to-a-random-string-at-least-32-chars-long
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# --- Rate limits ------------------------------------------------------------
RATE_LIMIT_PER_MINUTE=10
RATE_LIMIT_PER_HOUR=100

# --- Environment + CORS -----------------------------------------------------
# ENVIRONMENT=production enables strict CORS checking.
ENVIRONMENT=development
# Comma-separated list of allowed browser origins (localhost is always
# appended in code, so only list production origins here). Include BOTH
# your custom domain and the default Vercel URL — Vercel keeps the
# *.vercel.app URL live even after you attach a custom domain, and
# previews use a different hostname pattern.
# Example for this project:
#   CORS_ORIGINS=https://tradeinsight.shubair.in,https://tradeinsight-frontend.vercel.app
CORS_ORIGINS=
# Optional regex — matches against the incoming Origin. Useful for Vercel
# preview deploys (PR branches) and "all subdomains of my domain" coverage:
#   CORS_ORIGIN_REGEX=https://([a-z0-9-]+\.)?shubair\.in|https://.*\.vercel\.app
CORS_ORIGIN_REGEX=

# Public URL of the deployed frontend — attached to OpenRouter attribution
# headers. Set this on production. Use your primary custom domain when you
# have one.
#   PUBLIC_APP_URL=https://tradeinsight.shubair.in
PUBLIC_APP_URL=http://localhost:3000

# --- Database ---------------------------------------------------------------
# Leave unset for local dev (falls back to SQLite). For production, use a
# Postgres URL. Example (Supabase pooler, psycopg3 driver):
#   DATABASE_URL=postgresql+psycopg://USER:PASS@HOST:6543/postgres
DATABASE_URL=

# --- Payments ---------------------------------------------------------------
RAZORPAY_API_BASE_URL=https://api.razorpay.com/v1
RAZORPAY_CURRENCY=INR
RAZORPAY_TIMEOUT_SECONDS=15
WEBHOOK_DEAD_LETTER_PATH=./reports/failed_webhooks/razorpay_dead_letters.jsonl

# --- AI multimodal ----------------------------------------------------------
# OpenRouter-first defaults selected because OpenRouter currently exposes
# multiple free vision-capable models plus a low-cost dedicated TTS endpoint.
AI_VISION_PROVIDER=openrouter
AI_VISION_MAX_BYTES=10485760
OPENROUTER_VISION_MODEL=google/gemma-4-31b-it:free
OPENROUTER_VISION_FALLBACK_MODELS=google/gemma-4-26b-a4b-it:free,baidu/qianfan-ocr-fast:free,openrouter/free
OPENROUTER_TTS_MODEL=openai/gpt-4o-mini-tts-2025-12-15
GEMINI_VISION_MODEL=gemini-2.5-flash
GEMINI_TTS_MODEL=gemini-2.5-flash-preview-tts
TTS_DEFAULT_VOICE=nova
TTS_DEFAULT_FORMAT=mp3

# --- Cloud report storage (optional) ----------------------------------------
# When these are set, report markdown files are uploaded to Supabase Storage.
# Otherwise the backend falls back to the local ./reports directory (fine for
# dev, not safe on ephemeral hosts like Render where the disk wipes on deploy).
SUPABASE_URL=
# Service-role key (NOT the anon/publishable key). Treat this as a secret.
# Find it at: Supabase → Project Settings → API → service_role
SUPABASE_SERVICE_KEY=
# Bucket name to upload into. Create it in Supabase → Storage.
SUPABASE_REPORTS_BUCKET=reports

# Override the local reports directory for the fallback backend.
REPORTS_DIR=./reports

# --- Grounded research model (optional) -------------------------------------
# Override which Google model handles the grounded research step.
# GROUNDED_RESEARCH_MODEL=gemini-2.5-flash
